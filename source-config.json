{
  "schema_version": 2,
  "destination": "corpus",
  "max_corpus_bytes": 9500000,
  "sources": [
    {
      "id": "freecad-source",
      "type": "github",
      "repository": "FreeCAD/FreeCAD",
      "ref": "main",
      "web_url": "https://github.com/FreeCAD/FreeCAD",
      "destination": "freecad-source",
      "max_file_bytes": 1048576,
      "include_patterns": [
        "README.md",
        "LICENSE",
        "src/Doc/**/*.md",
        "src/Doc/**/*.rst",
        "src/Doc/**/*.txt",
        "src/Doc/**/*.dox",
        "src/Doc/**/*.dox.in",
        "src/Mod/mod.dox",
        "src/Mod/**/README*",
        "src/Mod/**/*.md",
        "src/Mod/**/*.rst",
        "src/Mod/**/*.dox",
        "src/Mod/**/*.dox.in"
      ],
      "exclude_patterns": [
        "**/CMakeLists.txt",
        "src/3rdParty/**",
        "src/**/3rdParty/**",
        "src/**/ThirdParty/**",
        "src/**/tests/**",
        "src/**/Tests/**",
        "src/Mod/**/*test*/**",
        "src/Mod/**/*Test*/**",
        "src/Mod/Test/**",
        "src/**/templates/**",
        "src/**/Templates/**",
        "src/**/Resources/**",
        "src/Mod/**/Roadmap/**",
        "src/**/libarea/**",
        "src/Mod/Robot/App/kdl_cp/**"
      ],
      "inventory_extensions": [
        ".md",
        ".rst",
        ".txt",
        ".dox",
        ".dox.in",
        ".uml",
        ".mm"
      ]
    },
    {
      "id": "freecad-wiki",
      "type": "mediawiki",
      "api_url": "https://wiki.freecad.org/api.php",
      "web_url": "https://wiki.freecad.org",
      "destination": "freecad-wiki",
      "language": "en",
      "namespace": 0,
      "categories": [
        "User Documentation",
        "Developer Documentation"
      ],
      "exclude_title_patterns": [
        "^Macro(?:[ :]|$)",
        "^Sandbox:"
      ],
      "max_page_bytes": 1048576
    }
  ]
}